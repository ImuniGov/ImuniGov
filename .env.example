# Copy to .env and set POSTGRES_PASSWORD before docker compose up.
POSTGRES_PASSWORD=
PUBLIC_ORIGIN=http://localhost:4173
COOKIE_SECURE=false
# Optional for local Python development (default: data/app.sqlite3)
# DATABASE_URL=postgresql+psycopg://imuniguia:password@localhost/imuniguia
# IMUNIGUI_DATA_DIR=data

APP_TIMEZONE=America/Cuiaba
# For public HTTPS deployment use your own HTTPS origin or contact URI.
VAPID_SUBJECT=https://localhost
